        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_job_id: $json.jobId, p_worker_id: $json.workerId, p_lease_token: $json.leaseToken, p_attempt_number: $json.attemptNumber, p_pipeline_revision: $json.pipelineRevision, p_lease_seconds: 120}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
