{
  "name": "Generate Narration",
  "nodes": [
    {
      "parameters": {
        "events": [
          "update"
        ]
      },
      "type": "n8n-nodes-base.workflowTrigger",
      "typeVersion": 1,
      "position": [
        -900,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060001",
      "name": "Workflow Trigger"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst jobId = input.jobId;\nif (!jobId || !/^[0-9a-f-]{36}$/i.test(jobId)) throw new Error('Invalid jobId');\nreturn [{json: {...input, jobId}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060002",
      "name": "Validate Input"
    },
    {
      "parameters": {
        "jsCode": "const context = $('Merge Heartbeat Context').first().json; return [{json: {...context, statusProjection: $json}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060003",
      "name": "Update Job Status"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/video_jobs?id=eq.' + $json.jobId + '&select=id,script_json' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -240,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060004",
      "name": "Get Script"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst job = Array.isArray(rows) ? rows[0] : rows;\nif (!job?.script_json) throw new Error('No script found for job');\nconst script = job.script_json;\nconst text = script.fullNarration || (script.scenes ? script.scenes.map(s => s.narration).join(' ') : '');\nif (!text) throw new Error('No narration text available');\nreturn [{ json: { jobId: job.id, text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060005",
      "name": "Extract Narration Text"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TTS_BASE_URL + '/tts' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.text.replace(/[\"]/gi, '\\\\\"') }}\",\n  \"voice\": \"af_heart\",\n  \"language\": \"en\"\n}",
        "options": {
          "response": {
            "response": {
              "response": {
                "format": "file"
              }
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060006",
      "name": "Call TTS"
    },
    {
      "parameters": {
        "jsCode": "const jobId = $('Validate Input').first().json.jobId;\nconst dir = '/data/jobs/' + jobId;\nconst fs = require('fs');\ntry { fs.mkdirSync(dir, { recursive: true }); } catch(e) {}\n\nconst binaryData = $input.first().binary;\nif (!binaryData?.data?.data) {\n  const jsonResponse = $input.first().json;\n  if (jsonResponse?.audio_url || jsonResponse?.public_url) {\n    return [{ json: { jobId, audio_url: jsonResponse.audio_url || jsonResponse.public_url, local_path: null } }];\n  }\n  throw new Error('No binary or audio URL received from TTS');\n}\n\nconst buffer = Buffer.from(binaryData.data.data, 'base64');\nconst path = dir + '/narration.wav';\nfs.writeFileSync(path, buffer);\n\nreturn [{ json: { jobId, local_path: path, file_size: buffer.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060007",
      "name": "Save Audio File"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/assets' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.jobId }}\",\n  \"asset_type\": \"audio\",\n  \"local_path\": \"{{ $json.local_path }}\",\n  \"mime_type\": \"audio/wav\",\n  \"file_size\": {{ $json.file_size === null ? 'null' : JSON.stringify($json.file_size) }},\n  \"created_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060008",
      "name": "Save Asset Record"
    },
    {
      "parameters": {
        "jsCode": "const jobId = $('Validate Input').first().json.jobId;\nreturn [{ json: { success: true, jobId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "62e71b10-1a2b-4c3d-8e9f-000000060009",
      "name": "Build Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst jobId = input.jobId ?? input.id;\nif (!jobId || !input.workerId || !input.leaseToken || input.attemptNumber == null || input.pipelineRevision == null) throw new Error('LEASE_CONTEXT_REQUIRED');\nconst stage = 'generate_voice';\nconst itemKey = input.itemKey ?? ('job' === 'scene_set' ? 'all-scenes' : 'job');\nconst canonical = JSON.stringify({jobId, pipelineRevision: input.pipelineRevision, stage, itemKey, revision: input.currentRevision ?? input.pipelineRevision});\nreturn [{json: {...input, jobId, stage, itemKey, stageHashInput: canonical, workerId: input.workerId, leaseToken: input.leaseToken, attemptNumber: Number(input.attemptNumber), pipelineRevision: Number(input.pipelineRevision)}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ],
      "id": "4b2-normalize-stage-context",
      "name": "Normalize Stage Context"
    },
    {
      "parameters": {
        "action": "hash",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.stageHashInput }}",
        "dataPropertyName": "inputHash",
        "encoding": "hex"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        -775,
        0
      ],
      "id": "4b2-hash-stage-input",
      "name": "Hash Stage Input"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/begin_job_stage' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_job_id: $json.jobId, p_pipeline_revision: $json.pipelineRevision, p_stage: $json.stage, p_item_key: $json.itemKey, p_input_hash: $json.inputHash, p_worker_id: $json.workerId, p_lease_token: $json.leaseToken, p_attempt_number: $json.attemptNumber}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -650,
        0
      ],
      "id": "4b2-begin-stage",
      "name": "Begin Stage"
    },
    {
      "parameters": {
        "jsCode": "const {stageHashInput, ...context} = $('Hash Stage Input').first().json;\nconst result = $json;\nreturn [{json: {...context, stageState: result.state, stageRunId: result.stage_run_id, runToken: result.run_token, cachedOutput: result.output}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ],
      "id": "4b2-merge-stage-context",
      "name": "Merge Stage Context"
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.stageState === 'STARTED' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -150,
        0
      ],
      "id": "4b2-stage-state",
      "name": "Stage Started?",
      "outputs": [
        "true",
        "false"
      ]
    },
    {
      "parameters": {
        "method": "POST",
