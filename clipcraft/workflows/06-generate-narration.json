      "id": "4b2-merge-heartbeat-context",
      "name": "Merge Heartbeat Context"
    },
    {
      "parameters": {
        "jsCode": "const context = $('Merge Stage Context').first().json;\nif (context.stageState !== 'CACHED_SUCCESS') throw new Error('STAGE_RECONCILIATION_REQUIRED');\nreturn [{json: {success: true, cached: true, jobId: context.jobId, stage: context.stage, stageRunId: context.stageRunId, output: context.cachedOutput}}];"
      },
      "type": "n8n-nodes-base.code",
