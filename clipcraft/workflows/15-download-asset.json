   "parameters": {
    "jsCode": "var headers = $json.headers || {};\nvar apiKey = headers['x-internal-api-key'] || headers['X-Internal-Api-Key'];\nif (!apiKey || apiKey !== $env.INTERNAL_API_KEY) {\n  return [{ json: { valid: false, statusCode: 401, error: 'Invalid or missing API key' } }];\n}\n\nvar jobId = $json.query.jobId;\nif (!jobId || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(jobId)) {\n  return [{ json: { valid: false, statusCode: 400, error: 'Invalid job UUID' } }];\n}\n\nif (jobId.indexOf('..') !== -1 || jobId.indexOf('/') !== -1 || jobId.indexOf('\\\\') !== -1) {\n  return [{ json: { valid: false, statusCode: 400, error: 'Invalid job ID: path traversal rejected' } }];\n}\n\nvar ALLOWED_ASSETS = {\n  video: { filename: 'final.mp4', mimeType: 'video/mp4', ext: 'mp4' },\n  thumbnail: { filename: 'thumbnail.jpg', mimeType: 'image/jpeg', ext: 'jpg' },\n  captions: { filename: 'captions.ass', mimeType: 'text/plain', ext: 'ass' }\n};\n\nvar asset = $json.query.asset;\nif (!asset || !ALLOWED_ASSETS[asset]) {\n  return [{ json: { valid: false, statusCode: 400, error: 'Invalid asset type. Allowed: video, thumbnail, captions' } }];\n}\n\nvar info = ALLOWED_ASSETS[asset];\nvar filePath = '/data/jobs/' + jobId + '/' + info.filename;\nvar downloadName = 'clipcraft-' + asset + '-' + jobId + '.' + info.ext;\n\nreturn [{ json: {\n  valid: true,\n  jobId: jobId,\n  asset: asset,\n  filePath: filePath,\n  mimeType: info.mimeType,\n  downloadName: downloadName\n} }];"
   },
