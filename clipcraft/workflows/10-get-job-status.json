      ],
      "id": "c3d4e5f6-a7b8-9012-cdef-12345678930a",
      "name": "Validate Job ID"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/video_jobs?id=eq.' + $json.jobId + '&select=id,status,progress,current_step,error_message,created_at,updated_at,script_json,output_url,thumbnail_url' }}",
