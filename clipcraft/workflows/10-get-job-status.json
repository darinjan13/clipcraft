      "webhookId": "b2c3d4e5-f6a7-8901-bcde-f12345678920"
    },
    {
      "parameters": {
        "jsCode": "const query = $json.query ?? {};\nconst jobId = query.jobId ?? $json.jobId;\nif (!jobId) throw new Error('jobId is required');\nif (!/^[0-9a-f-]{36}$/i.test(jobId)) throw new Error('Invalid jobId');\nreturn [{ json: { jobId } }];"
      },
      "type": "n8n-nodes-base.code",
