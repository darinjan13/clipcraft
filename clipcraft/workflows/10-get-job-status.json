      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        20,
        0
      ],
      "id": "e5f6a7b8-c9d0-1234-efab-12345678950c",
      "name": "Get Scene Counts"
    },
    {
      "parameters": {
        "jsCode": "const jobRow = $('Get Job Status').first().json;\nconst jobArray = Array.isArray(jobRow) ? jobRow : [jobRow];\nif (jobArray.length === 0) {\n  return [{ json: { found: false, error: 'Job not found' } }];\n}\nconst j = jobArray[0];\n\nconst sceneRows = $input.first().json;\nconst scenes = Array.isArray(sceneRows) ? sceneRows : [];\nconst completed = scenes.filter(s => s.generation_status === 'completed').length;\nconst failed = scenes.filter(s => s.generation_status === 'failed').length;\nconst total = scenes.length;\n\nconst result = {\n  found: true,\n  jobId: j.id,\n  status: j.status,\n  progress: j.progress,\n  currentStep: j.current_step,\n  sceneProgress: {\n    completed,\n    total,\n    failed\n  },\n  error: j.error_message || null,\n  createdAt: j.created_at,\n  updatedAt: j.updated_at\n};\n\nconst readyStatuses = ['script_ready', 'generating_images', 'generating_voice', 'rendering', 'completed'];\nif (readyStatuses.includes(j.status) && j.script_json) {\n  result.script = j.script_json;\n}\n\nif (j.status === 'completed') {\n  result.videoUrl = j.output_url;\n  result.thumbnailUrl = j.thumbnail_url;\n}\n\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
