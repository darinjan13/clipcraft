      "parameters": {
        "jsCode": "const job = $('Extract Job').first().json;\nconst sceneRows = $input.first().json;\nconst scenes = Array.isArray(sceneRows) ? sceneRows : [];\n\nconst downloadPath = '/webhook/videos/download?jobId=' + encodeURIComponent(job.id);\n\nconst result = {\n  jobId: job.id,\n  status: job.status,\n  title: (job.script_json || {}).title || '',\n  description: (job.script_json || {}).description || '',\n  hashtags: (job.script_json || {}).hashtags || [],\n  videoUrl: downloadPath + '&asset=video',\n  downloadUrl: downloadPath + '&asset=video&download=true',\n  thumbnailUrl: downloadPath + '&asset=thumbnail',\n  captionsUrl: downloadPath + '&asset=captions',\n  script: job.script_json || null,\n  scenes: scenes.map(function(s) {\n    return {\n      sceneIndex: s.scene_index,\n      narration: s.narration || '',\n      caption: s.caption || '',\n      durationSeconds: s.duration_seconds,\n      motion: s.motion,\n      transition: s.transition,\n      generationStatus: s.generation_status\n    };\n  })\n};\n\nreturn [{ json: result }];"
      },
