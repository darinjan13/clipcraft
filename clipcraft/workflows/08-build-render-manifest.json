      "typeVersion": 4.4,
      "position": [
        -400,
        -60
      ],
      "id": "d4d5cffa-c92a-4f64-a271-a3846ad6b101",
      "name": "Get Job"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/scenes?job_id=eq.' + ($json.jobId || $json.id) + '&order=scene_index.asc' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -400,
        80
      ],
      "id": "418bda36-f8bb-4523-999d-1041bbe08401",
      "name": "Get Scenes"
    },
    {
      "parameters": {
        "jsCode": "const jobRows = $('Get Job').first().json;\nconst sceneRows = $('Get Scenes').first().json;\nconst job = Array.isArray(jobRows) ? jobRows[0] : jobRows;\nconst scenes = Array.isArray(sceneRows) ? sceneRows : [];\nconst jobId = job.id;\n\nconst manifest = {\n  jobId: jobId,\n  width: 1080,\n  height: 1920,\n  fps: 30,\n  audio: '/data/jobs/' + jobId + '/narration.wav',\n  captions: '/data/jobs/' + jobId + '/captions.ass',\n  output: '/data/jobs/' + jobId + '/final.mp4',\n  scenes: scenes.map(s => ({\n    image: s.local_image_path || '/data/jobs/' + jobId + '/scene-' + String(s.scene_index).padStart(2, '0') + '.png',\n    duration: Number(s.duration_seconds) || 5,\n    motion: s.motion || 'zoom_in',\n    transition: s.transition || 'crossfade',\n    caption: s.caption || ''\n  }))\n};\n\nconst fs = require('fs');\nconst dir = '/data/jobs/' + jobId;\ntry { fs.mkdirSync(dir, { recursive: true }); } catch(e) {}\nfs.writeFileSync(dir + '/render-manifest.json', JSON.stringify(manifest, null, 2), 'utf8');\n\nreturn [{ json: { jobId, manifest } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "id": "370704a9-1bb1-4b0e-b613-660bc29e6501",
      "name": "Build Manifest"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/video_jobs?id=eq.' + $json.jobId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"render_manifest\":{{ JSON.stringify($json.manifest) }},\"updated_at\":\"{{ new Date().toISOString() }}\"}",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        0,
        0
      ],
      "id": "2b678f34-a20a-4c85-95e5-39890493cc01",
      "name": "Save Manifest"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Build Manifest').first().json;\nconst sceneCount = ctx.manifest.scenes.length;\nconst manifestPath = '/data/jobs/' + ctx.jobId + '/render-manifest.json';\nreturn [{ json: { success: true, jobId: ctx.jobId, manifestPath: manifestPath, sceneCount: sceneCount } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        -60
      ],
      "id": "96cdbf05-910b-4c10-838c-8a4c0e911c01",
      "name": "Build Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst jobId = input.jobId ?? input.id;\nif (!jobId || !input.workerId || !input.leaseToken || input.attemptNumber == null || input.pipelineRevision == null) throw new Error('LEASE_CONTEXT_REQUIRED');\nconst stage = 'build_manifest';\nconst itemKey = input.itemKey ?? ('job' === 'scene_set' ? 'all-scenes' : 'job');\nconst canonical = JSON.stringify({jobId, pipelineRevision: input.pipelineRevision, stage, itemKey, revision: input.currentRevision ?? input.pipelineRevision});\nreturn [{json: {...input, jobId, stage, itemKey, stageHashInput: canonical, workerId: input.workerId, leaseToken: input.leaseToken, attemptNumber: Number(input.attemptNumber), pipelineRevision: Number(input.pipelineRevision)}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ],
      "id": "4b2-normalize-stage-context",
      "name": "Normalize Stage Context"
    },
    {
      "parameters": {
        "action": "hash",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.stageHashInput }}",
        "dataPropertyName": "inputHash",
        "encoding": "hex"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        -775,
