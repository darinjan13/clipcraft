          "jsCode": "const ctx = $('Build Manifest').first().json;\nconst sceneCount = ctx.manifest.scenes.length;\nconst manifestPath = '/data/jobs/' + ctx.jobId + '/render-manifest.json';\nreturn [{ json: { success: true, jobId: ctx.jobId, manifestPath: manifestPath, sceneCount: sceneCount } }];"
