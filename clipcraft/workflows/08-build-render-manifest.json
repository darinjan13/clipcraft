      "name": "Begin Stage"
    },
    {
      "parameters": {
        "jsCode": "const {stageHashInput, ...context} = $('Hash Stage Input').first().json;\nconst result = $json;\nreturn [{json: {...context, stageState: result.state, stageRunId: result.stage_run_id, runToken: result.run_token, cachedOutput: result.output}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ],
      "id": "4b2-merge-stage-context",
      "name": "Merge Stage Context"
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.stageState === 'STARTED' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
