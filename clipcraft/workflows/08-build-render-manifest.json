      "typeVersion": 4.4,
      "position": [
        -400,
        80
      ],
      "id": "418bda36-f8bb-4523-999d-1041bbe08401",
      "name": "Get Scenes"
    },
    {
      "parameters": {
        "jsCode": "const jobRows = $('Get Job').first().json;\nconst job = Array.isArray(jobRows) ? jobRows[0] : jobRows;\nlet scenes = $('Get Scenes').all().map(item => item.json);\nconst jobId = job.id;\nif (!jobId || scenes.length === 0) throw new Error('MANIFEST_INPUT_REQUIRED');\n\nconst sourceTotal = scenes.reduce((sum, scene) => sum + (Number(scene.duration_seconds) || 0), 0);\nconst effectiveDuration = Number(job.effective_duration);\nif (!Number.isFinite(effectiveDuration) || effectiveDuration <= 0 || sourceTotal <= 0) throw new Error('MANIFEST_DURATION_REQUIRED');\n{\n  let allocated = 0;\n  scenes = scenes.map((scene, index) => {\n    const duration = index === scenes.length - 1\n      ? Math.round((effectiveDuration - allocated) * 100) / 100\n      : Math.round(((Number(scene.duration_seconds) || 0) / sourceTotal) * effectiveDuration * 100) / 100;\n    allocated += duration;\n    return { ...scene, duration_seconds: duration };\n  });\n}\n\nconst manifest = {\n  jobId,\n  width: 1080,\n  height: 1920,\n  fps: 30,\n  duration: effectiveDuration,\n  audio: '/data/jobs/' + jobId + '/narration.wav',\n  captions: '/data/jobs/' + jobId + '/captions.ass',\n  output: '/data/jobs/' + jobId + '/final.mp4',\n  scenes: scenes.map(s => ({\n    image: s.local_image_path || '/data/jobs/' + jobId + '/scene-' + String(s.scene_index).padStart(2, '0') + '.png',\n    duration: Number(s.duration_seconds),\n    motion: s.motion || 'zoom_in',\n    transition: s.transition || 'crossfade',\n    caption: s.caption || ''\n  }))\n};\nconst manifestPath = '/data/jobs/' + jobId + '/render-manifest.json';\nconst content = Buffer.from(JSON.stringify(manifest, null, 2), 'utf8');\nreturn [{\n  json: { jobId, manifest, manifestPath, sceneCount: scenes.length, fileSize: content.length },\n  binary: { data: { data: content.toString('base64'), mimeType: 'application/json', fileName: 'render-manifest.json' } }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "id": "370704a9-1bb1-4b0e-b613-660bc29e6501",
      "name": "Build Manifest"
    },
    {
      "parameters": {
        "fileName": "={{ $json.manifestPath }}",
        "dataPropertyName": "data"
      },
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        -100,
        0
      ],
      "id": "370704a9-1bb1-4b0e-b613-660bc29e6502",
      "name": "Write Render Manifest"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/video_jobs?id=eq.' + $('Build Manifest').first().json.jobId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({render_manifest: $('Build Manifest').first().json.manifest, updated_at: new Date().toISOString()}) }}",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        0,
        0
      ],
      "id": "2b678f34-a20a-4c85-95e5-39890493cc01",
      "name": "Save Manifest"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Build Manifest').first().json;\nconst sceneCount = ctx.manifest.scenes.length;\nconst manifestPath = '/data/jobs/' + ctx.jobId + '/render-manifest.json';\nreturn [{ json: { success: true, jobId: ctx.jobId, manifestPath: manifestPath, sceneCount: sceneCount } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        -60
      ],
      "id": "96cdbf05-910b-4c10-838c-8a4c0e911c01",
      "name": "Build Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst jobId = input.jobId ?? input.id;\nif (!jobId || !input.workerId || !input.leaseToken || input.attemptNumber == null || input.pipelineRevision == null) throw new Error('LEASE_CONTEXT_REQUIRED');\nconst stage = 'build_manifest';\nconst itemKey = input.itemKey ?? ('job' === 'scene_set' ? 'all-scenes' : 'job');\nconst canonical = JSON.stringify({jobId, pipelineRevision: input.pipelineRevision, stage, itemKey, revision: input.currentRevision ?? input.pipelineRevision});\nreturn [{json: {...input, jobId, stage, itemKey, stageHashInput: canonical, workerId: input.workerId, leaseToken: input.leaseToken, attemptNumber: Number(input.attemptNumber), pipelineRevision: Number(input.pipelineRevision)}}];"
      },
