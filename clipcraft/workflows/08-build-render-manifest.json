      ],
      "id": "0bd9e8be-06bf-4c52-9fe0-fdba1ee88a01",
      "name": "Workflow Trigger"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst jobId = input.jobId;\nif (!jobId || !/^[0-9a-f-]{36}$/i.test(jobId)) throw new Error('Invalid jobId');\nreturn [{json: {...input, jobId}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        0
      ],
      "id": "b5a539f5-85b1-4256-ba44-413ef3f788d1",
      "name": "Validate Input"
    },
    {
      "parameters": {
        "jsCode": "const context = $('Merge Heartbeat Context').first().json; return [{json: {...context, statusProjection: $json}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ],
      "id": "dbdf5e26-0143-40f9-b312-0735c47d5c01",
      "name": "Update Job Status"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/video_jobs?id=eq.' + ($json.jobId || $json.id) + '&select=id,brief_json,script_json' }}",
        "sendHeaders": true,
