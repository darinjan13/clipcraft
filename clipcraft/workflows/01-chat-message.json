      "id": "e10001a0-1000-4000-8000-100000000001",
      "name": "Chat Webhook",
      "webhookId": "e10001a0-1000-4000-8000-1000000000a1"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nif (!body.sessionId || !body.message) {\n  throw new Error('sessionId and message are required');\n}\nconst brief = body.brief ?? {};\nconst message = String(body.message).trim();\n\nconst inferred = {\n  topic: brief.topic ?? null,\n  duration: brief.duration ?? null,\n  sceneCount: brief.sceneCount ?? null,\n  language: brief.language ?? 'English',\n  contentStyle: brief.contentStyle ?? null,\n  visualStyle: brief.visualStyle ?? null,\n  voiceTone: brief.voiceTone ?? null,\n  captionStyle: brief.captionStyle ?? 'bold highlighted words',\n  aspectRatio: '9:16'\n};\n\nif (!inferred.topic && message.length > 8) inferred.topic = message;\nif (inferred.duration && !inferred.sceneCount) {\n  inferred.sceneCount = Math.ceil(Number(inferred.duration) / 5);\n}\n\nconst missing = [];\nif (!inferred.topic) missing.push('topic');\nif (!inferred.duration) missing.push('duration');\nif (!inferred.sceneCount) missing.push('sceneCount');\nif (!inferred.contentStyle) missing.push('contentStyle');\nif (!inferred.visualStyle) missing.push('visualStyle');\nif (!inferred.voiceTone) missing.push('voiceTone');\n\nreturn [{ json: {\n  sessionId: body.sessionId,\n  channelId: body.channelId ?? 'default',\n  message,\n  brief: inferred,\n  missing\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        0
      ],
      "id": "e10001a0-1000-4000-8000-100000000002",
      "name": "Validate Chat Input"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/chat_messages?session_id=eq.' + $json.sessionId + '&order=created_at.asc&select=role,content' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -600,
        0
      ],
      "id": "e10001a0-1000-4000-8000-100000000003",
      "name": "Load Chat History"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Validate Chat Input').first().json;\nconst historyRows = $input.first().json;\nconst history = Array.isArray(historyRows) ? historyRows.map(m => ({ role: m.role, content: m.content })) : [];\nreturn [{ json: { ...ctx, history } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        0
      ],
      "id": "e10001a0-1000-4000-8000-100000000004",
      "name": "Add History"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ctx = $('Validate Chat Input').first().json;\nif (response.success === false) {\n  return [{ json: { status: 'error', sessionId: ctx.sessionId, message: response.error?.message || 'Text generation failed', question: null, brief: ctx.brief } }];\n}\nconst raw = response.result;\nlet text = typeof raw === 'string' ? raw : JSON.stringify(raw);\ntext = text.replace(/```json\\n?/gi, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  throw new Error('Cloudflare returned invalid JSON');\n}\n\nparsed.sessionId = ctx.sessionId;\nparsed.userMessage = ctx.message;\nreturn [{ json: parsed }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "e10001a0-1000-4000-8000-100000000006",
      "name": "Parse Brief Response"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/chat_messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{ $json.sessionId }}\",\n  \"role\": \"user\",\n  \"content\": \"{{ $json.userMessage }}\",\n  \"metadata_json\": {{ JSON.stringify($json.brief ?? $json) }},\n  \"created_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {
          "response": {
            "response": {}
          }
        }
