    },
    {
      "parameters": {
        "jsCode": "const ai = $('Parse Brief Response').first().json;\nconst brief = ai.brief ?? ai;\nif (brief.duration && !brief.sceneCount) {\n  brief.sceneCount = Math.ceil(Number(brief.duration) / 5);\n}\nreturn [{ json: {\n  status: ai.status,\n  sessionId: ai.sessionId,\n  message: ai.message,\n  question: ai.question ?? null,\n  brief\n} }];"
      },
