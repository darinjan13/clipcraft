# Backend API
N8N_BASE_URL=http://127.0.0.1:5680
N8N_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
CLIPCRAFT_DATA_DIR=/data/jobs
SHADOW_PROVIDER_EXECUTION=false
SHADOW_RUNTIME_COMPARISON=true

# Frontend (public values only; never place secrets in VITE_* variables)
VITE_API_BASE_URL=http://127.0.0.1:8000

# n8n runtime
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5680
WEBHOOK_URL=http://localhost:5680/
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# AI routing
AI_TEXT_PROVIDER=cloudflare
AI_IMAGE_PROVIDER=cloudflare
TEXT_EXECUTION_MODE=internal
IMAGE_EXECUTION_MODE=internal

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Stored provider credential encryption
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# Internal service authentication
INTERNAL_API_KEY=
N8N_INTERNAL_SIGNING_SECRET=
CLIPCRAFT_INTERNAL_API_BASE_URL=http://clipcraft-backend:8000

# Storage and media URLs
VIDEO_STORAGE_PATH=/data/jobs
PUBLIC_VIDEO_BASE_URL=

# TTS and renderer
TTS_BASE_URL=http://clipcraft-tts:8000
PORT=8000
PIPER_MODEL=/app/models/en_US-lessac-medium.onnx
RENDER_SERVER_PORT=8088

# Future provider placeholder only; NVIDIA is not implemented in this baseline
NVIDIA_API_KEY=

# Optional workflow/runtime verification
CLIPCRAFT_ENABLE_RUNTIME_TESTS=false
WF17_ID=
WF18_ID=
WF17_EXPECTED_NAME=AI Generate Text
WF18_EXPECTED_NAME=AI Generate Image
N8N_TEST_TIMEOUT_SECONDS=60
N8N_TEST_POLL_INTERVAL_SECONDS=2
N8N_EXECUTION_CLOCK_SKEW_SECONDS=5
N8N_MAX_EXECUTION_PAGES=20

# Optional isolated smoke environment
CLIPCRAFT_ENV=test
CLIPCRAFT_SMOKE_TEST_MODE=false
CLIPCRAFT_SUPABASE_PROJECT_REF=
CLIPCRAFT_SUPABASE_HOST_ALLOWLIST=
SUPABASE_ANON_KEY=
CLIPCRAFT_STORAGE_MODE=dedicated_bucket
CLIPCRAFT_STORAGE_BUCKET=
CLIPCRAFT_STORAGE_HOST=
CLIPCRAFT_STORAGE_HOST_ALLOWLIST=
CLIPCRAFT_TEXT_PROVIDER_MODE=mock
CLIPCRAFT_TEXT_PROVIDER_ENDPOINT=mock://text
CLIPCRAFT_IMAGE_PROVIDER_MODE=mock
CLIPCRAFT_IMAGE_PROVIDER_ENDPOINT=mock://image
CLIPCRAFT_TTS_MODE=mock
CLIPCRAFT_TTS_ENDPOINT=mock://tts
CLIPCRAFT_RENDERER_MODE=mock
CLIPCRAFT_RENDERER_ENDPOINT=mock://renderer
CLIPCRAFT_N8N_INTERNAL_URL=
CLIPCRAFT_N8N_HOST_ALLOWLIST=
CLIPCRAFT_CALLBACK_URL=
CLIPCRAFT_TEST_NAMESPACE=
CLIPCRAFT_CORRELATION_ID=
CLIPCRAFT_IDEMPOTENCY_KEY=
CLIPCRAFT_CLEANUP_MODE=strict_namespace
